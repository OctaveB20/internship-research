# Copie ce fichier en .env et remplis tes clés (ne jamais committer .env).
RAPIDAPI_KEY=
GEMINI_API_KEY=
# Optionnels, selon llm_provider dans config.yaml
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Mot de passe de l'app (fortement conseillé en ligne)
APP_PASSWORD=
# 1 = aucun appel réseau, lecture de tests/fixtures/*.json
DEV_MODE=1
# Base Postgres (ex. Neon) : adresse avec « Connection pooling ». Vide = SQLite local.
DATABASE_URL=
# Optionnel : mot de passe de la base, s'il contient des caractères spéciaux
# DATABASE_PASSWORD=
# Optionnel : autre emplacement pour la base SQLite
# JOBS_DB=data/jobs.db
